{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "Resturant.Api",
    "Audience": "Resturant.Client",
    "Secret": "",
    "ExpirationMinutes": 10
  },

  "AuthenticationSessions": {
    "AbsoluteLifetimeDays": 30,
    "RefreshLifetimeDays": 7
  },

  "BrowserSecurity": {
    "AllowedOrigins": []
  },

  "Swagger": {
    "Enabled": false
  },

  "Seed": {
    "Enabled": false
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },

    "Enrich": [
      "FromLogContext"
    ],

    "WriteTo": [
      {
        "Name": "Console"
      }
    ],

    "Properties": {
      "Application": "Resturant.Api"
    }
  }
}