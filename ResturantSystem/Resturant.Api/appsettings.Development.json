{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ResturantDb_Development;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "BrowserSecurity": {
    "AllowedOrigins": [
      "https://localhost:7261"
    ]
  },

  "Swagger": {
    "Enabled": true
  },

  "Seed": {
    "Enabled": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}